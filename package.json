{
  "name": "brewlog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env.local scripts/init-db.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/init-db.mjs --seed",
    "db:reset": "node --env-file-if-exists=.env.local scripts/init-db.mjs --reset --seed",
    "db:init:test": "node scripts/init-db.mjs file:./data/test.db --reset --seed",
    "migrate:phase3": "node --env-file-if-exists=.env.local scripts/migrate-phase3.mjs",
    "migrate:phase4": "node --env-file-if-exists=.env.local scripts/migrate-phase4.mjs",
    "migrate:phase5": "node --env-file-if-exists=.env.local scripts/migrate-phase5.mjs",
    "migrate:username": "node --env-file-if-exists=.env.local scripts/migrate-username.mjs",
    "migrate:drop-cafe-website": "node --env-file-if-exists=.env.local scripts/migrate-drop-cafe-website.mjs",
    "migrate:orphan-cafes": "node --env-file-if-exists=.env.local scripts/migrate-orphan-cafes.mjs",
    "reset-password": "node --env-file-if-exists=.env.local scripts/reset-password.mjs",
    "test:e2e": "npm run build && npm run db:init:test && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@libsql/client": "^0.17.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "leaflet": "^1.9.4",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
