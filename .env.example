# ===== Database (Phase 1) — see docs/setup/turso-setup.md =====
# Local development works with no cloud account:
TURSO_DATABASE_URL=file:./data/brewlog.db
# Production (Turso cloud):
# TURSO_DATABASE_URL=libsql://brewlog-yourname.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# ===== Photo storage (Phase 2) — see docs/setup/r2-setup.md =====
# Optional: when unset, photos are stored on local disk under data/uploads/.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=brewlog-photos
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ===== Authentication (Phase 3) — see docs/setup/oauth-setup.md =====
# Required everywhere (generate with `npx auth secret` or `openssl rand -base64 33`):
AUTH_SECRET=generate-me
# OAuth providers (optional locally — dev login covers local use; required on Vercel):
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# Dev-only one-click login (NEVER set on Vercel — would allow passwordless login as anyone):
AUTH_DEV_LOGIN=true
# Required for `next start` on localhost; NOT needed on Vercel:
AUTH_TRUST_HOST=true
